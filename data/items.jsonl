{"attention_required": false, "candidate_links": [], "canonical_url": "https://starlink.com/updates/starlink-beam-switching", "category": "starlink_update", "change_reason": "no_semantic_change", "change_status": "unchanged", "collector": "official_item_extraction_v2", "consecutive_detail_failures": 0, "consecutive_missing_observations": 0, "content_hash": "bbda025dc135eb82", "current_run_data_reused": false, "date_text": null, "detail_fetch_status": "success", "detail_page_hash": "4048464cde492cbe", "detail_parse_method": "rendered", "discovery_method": "rendered_dom", "evidence": "Starlink is built to deliver reliable high-speed internet, even when a customer’s view of the sky isn’t perfect. Trees, buildings, and other obstacles can temporarily block the connection to a given satellite, but the system is designed in such a way that these are generally imperceptible to the user. A given user terminal in the US has 10s of satellites in view, providing diversity to route traffic via a satellite with a stable and unobstructed connection. Starlink terminals automatically switch between satellites in real time to address any degradation in the link: this happens both proactively, for fixed installs, and reactively, for mobile terminals and unpredicted issues. As a Starlink terminal communicates with satellites overhead, it continuously builds a real-time obstruction map, allowing Starlink to dynamically understand its environment. With this information, it can proactively select the best and most stable connection. These proactive satellite switches are imperceptible to the user and occur many times per minute – with Starlink’s low-Earth-orbiting satellites rapidly transiting the sky, it’s a natural part of the system. For dynamic obstructions, such as are encount", "extracted_level": "item_level", "extraction_change_status": "unchanged", "extraction_confidence": 0.8, "extraction_hash": "9c982848db988192", "extraction_notes": "条目字段来自官方详情页或明确的官方索引证据；未从 URL slug 推断日期或任务事实。", "extraction_revision": 1, "extraction_warnings": [], "fetched_at": "2026-08-03T03:52:32+00:00", "field_evidence": {"evidence": "rendered_meaningful_paragraph", "summary": "rendered_meta_description", "title": "rendered_h1"}, "first_seen_at": "2026-07-15T15:30:05+08:00", "http_status": 200, "id": "495a49c7d5c93cbc", "is_starlink_related": true, "language": "en", "last_changed_at": "2026-07-15T15:30:05+08:00", "last_detail_attempt_at": "2026-08-03T03:52:32+00:00", "last_detail_error_type": null, "last_detail_success_at": "2026-08-03T03:52:32+00:00", "last_extraction_improvement_at": null, "last_lifecycle_event": "lifecycle_initialized", "last_seen_at": "2026-08-03T03:52:32+00:00", "last_semantic_change_at": null, "lifecycle_events_this_run": [], "lifecycle_state": "active", "matched_keywords": ["starlink"], "missing_since": null, "modified_at": null, "modified_date_text": null, "parser_version": "starlink_updates_item_v2", "previous_content_hash": "bbda025dc135eb82", "published_at": null, "published_date_text": null, "record_scope": "item", "record_type": "official_update", "relevance_reason": "条目来自 Starlink 官方 Updates 详情路径。", "reliability_tier": "S", "seen_in_current_index": true, "semantic_change_evidence": {}, "semantic_content_hash": "bbda025dc135eb82", "semantic_version": 1, "source_id": "starlink_official_updates", "source_name": "Starlink Official Updates", "source_quality": "medium", "source_type": "official", "starlink_relevance": "direct", "structured_fields": {}, "summary": "Starlink uses beam switching to automatically route around obstacles for reliable high-speed internet.", "title": "Starlink Beam Switching", "url": "https://starlink.com/updates/starlink-beam-switching"}
{"attention_required": false, "candidate_links": [], "canonical_url": "https://starlink.com/updates/network-update", "category": "starlink_update", "change_reason": "no_semantic_change", "change_status": "unchanged", "collector": "official_item_extraction_v2", "consecutive_detail_failures": 0, "consecutive_missing_observations": 0, "content_hash": "a73aef78a8f128de", "current_run_data_reused": false, "date_text": null, "detail_fetch_status": "success", "detail_page_hash": "4c6c177761f64bd0", "detail_parse_method": "rendered", "discovery_method": "rendered_dom", "evidence": "Over the past year, Starlink has expanded to 42 new countries, territories and other markets around the world while growing by 2.7 million+ active customers globally and serving more than 6 million and counting with high-speed, low-latency internet. During that time, the SpaceX team has also launched more than 100 Starlink missions, adding 2,300+ satellites to the constellation, and invested heavily in our ground infrastructure, network backbone, and internal technologies and systems. As a result, Starlink can provide download speeds of 100s of Mbps to individual customers. In the United States alone, the median download speed across more than 2 million active Starlink customers during times of peak demand is nearly 200 Mbps as of July 2025. Even Starlink's lower speed tier offering currently serves customers with 100 Mbps download and 20 Mbps upload speeds in most states and territories. And as we continue to connect more people with high-speed internet around the world in the months and years ahead, the Starlink team is focused on ensuring the overall quality of service for new and existing customers continually improves.", "extracted_level": "item_level", "extraction_change_status": "unchanged", "extraction_confidence": 0.8, "extraction_hash": "9c982848db988192", "extraction_notes": "条目字段来自官方详情页或明确的官方索引证据；未从 URL slug 推断日期或任务事实。", "extraction_revision": 1, "extraction_warnings": [], "fetched_at": "2026-08-03T03:52:32+00:00", "field_evidence": {"evidence": "rendered_meaningful_paragraph", "summary": "rendered_meta_description", "title": "rendered_h1"}, "first_seen_at": "2026-07-15T15:34:13+08:00", "http_status": 200, "id": "d3b89bb9510b1b9a", "is_starlink_related": true, "language": "en", "last_changed_at": "2026-07-15T15:34:13+08:00", "last_detail_attempt_at": "2026-08-03T03:52:32+00:00", "last_detail_error_type": null, "last_detail_success_at": "2026-08-03T03:52:32+00:00", "last_extraction_improvement_at": null, "last_lifecycle_event": "lifecycle_initialized", "last_seen_at": "2026-08-03T03:52:32+00:00", "last_semantic_change_at": null, "lifecycle_events_this_run": [], "lifecycle_state": "active", "matched_keywords": ["starlink"], "missing_since": null, "modified_at": null, "modified_date_text": null, "parser_version": "starlink_updates_item_v2", "previous_content_hash": "a73aef78a8f128de", "published_at": null, "published_date_text": null, "record_scope": "item", "record_type": "official_update", "relevance_reason": "条目来自 Starlink 官方 Updates 详情路径。", "reliability_tier": "S", "seen_in_current_index": true, "semantic_change_evidence": {}, "semantic_content_hash": "a73aef78a8f128de", "semantic_version": 1, "source_id": "starlink_official_updates", "source_name": "Starlink Official Updates", "source_quality": "medium", "source_type": "official", "starlink_relevance": "direct", "structured_fields": {}, "summary": "Latest updates on Starlink network speeds, latency, resilience, scalability, and capacity.", "title": "Starlink Network Update", "url": "https://starlink.com/updates/network-update"}
{"attention_required": false, "candidate_links": [], "canonical_url": "https://starlink.com/updates/space-safety-web-interface", "category": "starlink_update", "change_reason": "no_semantic_change", "change_status": "unchanged", "collector": "official_item_extraction_v2", "consecutive_detail_failures": 0, "consecutive_missing_observations": 0, "content_hash": "782864df0d71359e", "current_run_data_reused": false, "date_text": null, "detail_fetch_status": "success", "detail_page_hash": "867b34367755be20", "detail_parse_method": "rendered", "discovery_method": "rendered_dom", "evidence": "To ensure safe spaceflight for everyone, all satellite operators should track their spacecraft with onboard GNSS, accurately predict their future trajectories, and broadcast that information to other satellite operators. Starlink currently publishes its ephemeris to multiple conjunction screening platforms and makes them available on our public website . For the past two years, Starlink has provided free, low-latency conjunction screening to participating satellite operators via our Space Traffic Coordination APIs . Earlier this Spring, we announced Stargaze , Starlink's Space Situational Awareness (SSA) system. Stargaze leverages a network of over 30,000 optical sensors to track 50% of objects below 600km perigee, and has begun releasing conjunction data messages (CDMs). These actions do not obviate the need for operators to share high-quality ephemerides, including planned maneuvers. Doing so remains critical to flight safety.", "extracted_level": "item_level", "extraction_change_status": "unchanged", "extraction_confidence": 0.8, "extraction_hash": "9c982848db988192", "extraction_notes": "条目字段来自官方详情页或明确的官方索引证据；未从 URL slug 推断日期或任务事实。", "extraction_revision": 2, "extraction_warnings": [], "fetched_at": "2026-08-03T03:52:32+00:00", "field_evidence": {"evidence": "rendered_meaningful_paragraph", "summary": "rendered_meta_description", "title": "rendered_h1"}, "first_seen_at": "2026-07-15T15:30:05+08:00", "http_status": 200, "id": "044bafcf1089533d", "is_starlink_related": true, "language": "en", "last_changed_at": "2026-07-15T15:30:05+08:00", "last_detail_attempt_at": "2026-08-03T03:52:32+00:00", "last_detail_error_type": null, "last_detail_success_at": "2026-08-03T03:52:32+00:00", "last_extraction_improvement_at": "2026-07-15T09:48:04+00:00", "last_lifecycle_event": "extraction_improved", "last_seen_at": "2026-08-03T03:52:32+00:00", "last_semantic_change_at": null, "lifecycle_events_this_run": [], "lifecycle_state": "active", "matched_keywords": ["starlink"], "missing_since": null, "modified_at": null, "modified_date_text": null, "parser_version": "starlink_updates_item_v2", "previous_content_hash": "782864df0d71359e", "published_at": null, "published_date_text": null, "record_scope": "item", "record_type": "official_update", "relevance_reason": "条目来自 Starlink 官方 Updates 详情路径。", "reliability_tier": "S", "seen_in_current_index": true, "semantic_change_evidence": {}, "semantic_content_hash": "782864df0d71359e", "semantic_version": 1, "source_id": "starlink_official_updates", "source_name": "Starlink Official Updates", "source_quality": "medium", "source_type": "official", "starlink_relevance": "direct", "structured_fields": {}, "summary": "A new web-based tool that simplifies satellite conjunction screening and ephemeris sharing for operators.", "title": "Space Safety Web Interface", "url": "https://starlink.com/updates/space-safety-web-interface"}
{"attention_required": false, "candidate_links": [], "canonical_url": "https://starlink.com/updates/starlink-version-3-satellites", "category": "starlink_update", "change_reason": "no_semantic_change", "change_status": "unchanged", "collector": "official_item_extraction_v2", "consecutive_detail_failures": 0, "consecutive_missing_observations": 0, "content_hash": "66117236912f2019", "current_run_data_reused": false, "date_text": null, "detail_fetch_status": "success", "detail_page_hash": "1415a217abd86193", "detail_parse_method": "rendered", "discovery_method": "rendered_dom", "evidence": "The greater data density and number of beams from the new phased arrays are enabled by our next generation of SpaceX-developed beamformer chips. This ensures that information is routed efficiently and correctly across various beams. Additionally, the V3 satellites phased arrays are fed by upgraded chips that support a ~64x increase in throughput handled per modem chip. This increase enables us to more efficiently serve customers simultaneously in both densely and sparsely populated regions and adapt beam data density in real-time to match the data needs of customers.", "extracted_level": "item_level", "extraction_change_status": "unchanged", "extraction_confidence": 0.8, "extraction_hash": "9c982848db988192", "extraction_notes": "条目字段来自官方详情页或明确的官方索引证据；未从 URL slug 推断日期或任务事实。", "extraction_revision": 1, "extraction_warnings": [], "fetched_at": "2026-08-03T03:52:32+00:00", "field_evidence": {"evidence": "rendered_meaningful_paragraph", "summary": "rendered_meta_description", "title": "rendered_h1"}, "first_seen_at": "2026-07-20T04:02:30+00:00", "http_status": 200, "id": "ba5555615b6e6fb6", "is_starlink_related": true, "language": "en", "last_changed_at": "2026-07-20T04:02:30+00:00", "last_detail_attempt_at": "2026-08-03T03:52:32+00:00", "last_detail_error_type": null, "last_detail_success_at": "2026-08-03T03:52:32+00:00", "last_extraction_improvement_at": null, "last_lifecycle_event":